<Window x:Class="ShaderCacheCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ShaderCacheCleaner.Converters"
        Title="SHADER CACHE CLEANER"
        Width="520" Height="620"
        MinWidth="520" MinHeight="620"
        MaxWidth="520" MaxHeight="620"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        Background="#FF0B0B0B"
        FontFamily="{StaticResource AppFont}"
        ResizeMode="CanMinimize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <converters:StringToBrushConverter x:Key="StringToBrush"/>

        <!-- Scrollbar invisible : molette OK, aucun rail visible -->
        <Style x:Key="InvisibleScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="0"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="InvisibleScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="CanContentScroll" Value="False"/>
            <Setter Property="PanningMode" Value="VerticalOnly"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="Transparent">
                            <ScrollContentPresenter Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            <!-- ScrollBars absents du template = invisibles, molette conserve le défilement -->
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SocialButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FF0B0B0B">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header fixe -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="8" Background="#FF1A1A1A" BorderBrush="#FF2A2A2A" BorderThickness="1">
                    <Canvas Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Canvas.Top="1" Width="18" Height="4" RadiusX="2" RadiusY="2" Fill="#76B900"/>
                        <Rectangle Canvas.Top="7" Canvas.Left="2" Width="14" Height="4" RadiusX="2" RadiusY="2" Fill="#76B900" Opacity="0.85"/>
                        <Rectangle Canvas.Top="13" Canvas.Left="3" Width="12" Height="4" RadiusX="2" RadiusY="2" Fill="#76B900" Opacity="0.65"/>
                    </Canvas>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="SHADER CACHE CLEANER" Style="{StaticResource TitleText}" FontSize="15"
                                   VerticalAlignment="Bottom"/>
                        <TextBlock Text=" by Syokos" FontSize="10" FontWeight="Normal" FontStyle="Italic"
                                   Foreground="#FF7A7A7A" Margin="6,0,0,2" VerticalAlignment="Bottom"
                                   FontFamily="{StaticResource AppFont}"/>
                    </StackPanel>
                    <TextBlock Text="GAMING SHADER MAINTENANCE" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold"/>
                </StackPanel>

                <Border Grid.Column="2" CornerRadius="10" Padding="9,4" VerticalAlignment="Center" Background="#18FFFFFF">
                    <TextBlock Text="{Binding StatusBadge}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{Binding StatusBadgeColor, Converter={StaticResource StringToBrush}}"/>
                </Border>
            </Grid>

            <!-- Contenu défilable (molette, sans scrollbar visible) -->
            <ScrollViewer Grid.Row="1"
                          Style="{StaticResource InvisibleScrollViewer}"
                          Focusable="True"
                          PreviewMouseWheel="ContentScrollViewer_PreviewMouseWheel">
                <StackPanel Margin="0,0,0,8">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding WindowsDetail}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding NvidiaDetail}" Style="{StaticResource MutedText}" Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SteamDetail}" Style="{StaticResource MutedText}" Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding PrimaryLabel}" Style="{StaticResource MutedText}" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Text="{Binding PrimarySizeText}" FontSize="32" FontWeight="Bold" Margin="0,0,0,6"
                                       Foreground="{Binding StatusBadgeColor, Converter={StaticResource StringToBrush}}"/>
                            <Border x:Name="BarTrack" Height="7" CornerRadius="4" Background="#FF2A2A2A" SizeChanged="BarTrack_SizeChanged">
                                <Border x:Name="BarFill" HorizontalAlignment="Left" CornerRadius="4"
                                        Background="{Binding BarBrush}" Width="0"/>
                            </Border>
                            <TextBlock Text="{Binding CacheDetailLine}" Style="{StaticResource MutedText}" Margin="0,6,0,0" FontSize="10" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Mode de nettoyage" Foreground="White" FontWeight="SemiBold" Margin="2,0,0,6" FontSize="12"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="Cs2Button" Grid.Column="0" Style="{StaticResource ModeButton}" Command="{Binding SelectCs2Command}" Padding="10,9">
                            <StackPanel>
                                <TextBlock Text="CS2 CLEAN" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                <TextBlock Text="Caches CS2" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="10"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="FullButton" Grid.Column="2" Style="{StaticResource ModeButton}" Command="{Binding SelectFullCommand}" Padding="10,9">
                            <StackPanel>
                                <TextBlock Text="FULL CLEAN" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                <TextBlock Text="Tous les caches" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="10"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding WarningText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#FFB08A3E" FontSize="10"/>

                    <Button Content="DÉMARRER LE NETTOYAGE"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartCleanupCommand}"
                            Margin="0,0,0,8"
                            Padding="12,11"/>

                    <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="8" Background="#221A1208"
                            Visibility="{Binding CountdownActive, Converter={StaticResource BoolToVis}}"
                            BorderBrush="#33F5A623" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CountdownSeconds, StringFormat=Redémarrage dans {0} s}"
                                       Foreground="{StaticResource OrangeBrush}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextWrapping="NoWrap"/>
                            <Button Grid.Column="1" Content="Annuler" Style="{StaticResource GhostButton}"
                                    Command="{Binding CancelCountdownCommand}" Padding="10,5" FontSize="11"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding StepText}" Foreground="White" TextWrapping="Wrap" FontSize="11"/>
                            <TextBlock Text="{Binding FolderText}" Style="{StaticResource MutedText}" Margin="0,3,0,0" TextWrapping="Wrap" FontSize="10"/>
                            <ProgressBar Height="5" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                         Value="{Binding ProgressPercent}"
                                         Foreground="{StaticResource NvidiaGreenBrush}"
                                         Background="#FF2A2A2A" BorderThickness="0"/>
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,0,4"
                            Visibility="{Binding ShowResultPanel, Converter={StaticResource BoolToVis}}"
                            BorderBrush="{StaticResource NvidiaGreenBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding ResultModeText}" FontWeight="Bold" Foreground="{StaticResource NvidiaGreenBrush}" FontSize="12"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Avant" Style="{StaticResource MutedText}" FontSize="10"/>
                                    <TextBlock Text="{Binding BeforeText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource OrangeBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Après" Style="{StaticResource MutedText}" FontSize="10"/>
                                    <TextBlock Text="{Binding AfterText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource NvidiaGreenBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Espace libéré" Style="{StaticResource MutedText}" FontSize="10"/>
                                    <TextBlock Text="{Binding FreedText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource NvidiaGreenBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Pied de page fixe : Rescanner / réseaux / Raccourci -->
            <Border Grid.Row="2" Background="#FF0B0B0B" Padding="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Rescanner" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshScanCommand}" HorizontalAlignment="Left" Padding="8,5" FontSize="11"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Steam officiel (PNG issu du SVG Simple Icons) -->
                        <Button Style="{StaticResource SocialButton}" Command="{Binding OpenSteamCommand}" ToolTip="Steam">
                            <Image Width="15" Height="15" Stretch="Uniform"
                                   Source="pack://application:,,,/Assets/steam.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                        <Button Style="{StaticResource SocialButton}" Command="{Binding OpenYouTubeCommand}" ToolTip="YouTube">
                            <Viewbox Width="16" Height="16">
                                <Path Fill="#B0B0B0" Stretch="Uniform"
                                      Data="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                            </Viewbox>
                        </Button>

                        <Button Style="{StaticResource SocialButton}" Command="{Binding OpenDiscordCommand}" ToolTip="Discord — Syokos">
                            <Viewbox Width="15" Height="15">
                                <Path Fill="#B0B0B0" Stretch="Uniform"
                                      Data="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Raccourci" Style="{StaticResource GhostButton}"
                            Command="{Binding CreateShortcutCommand}" HorizontalAlignment="Right" Padding="8,5" FontSize="11"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
