<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#FF0B0B0B</Color>
    <Color x:Key="PanelColor">#FF141414</Color>
    <Color x:Key="PanelAltColor">#FF1A1A1A</Color>
    <Color x:Key="BorderColor">#FF2A2A2A</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="TextMutedColor">#FF9A9A9A</Color>
    <Color x:Key="NvidiaGreenColor">#FF76B900</Color>
    <Color x:Key="NvidiaGreenDarkColor">#FF5A8F00</Color>
    <Color x:Key="OrangeColor">#FFF5A623</Color>
    <Color x:Key="RedColor">#FFE74C3C</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}"/>
    <SolidColorBrush x:Key="BorderBrushKey" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="NvidiaGreenBrush" Color="{StaticResource NvidiaGreenColor}"/>
    <SolidColorBrush x:Key="NvidiaGreenDarkBrush" Color="{StaticResource NvidiaGreenDarkColor}"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}"/>

    <FontFamily x:Key="AppFont">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
</ResourceDictionary>
