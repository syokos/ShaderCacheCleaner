<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ShaderCacheCleaner</RootNamespace>
    <AssemblyName>ShaderCacheCleaner</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <Version>1.0.0</Version>
    <Product>Shader Cache Cleaner</Product>
    <Company>Syokos</Company>
    <Authors>Syokos</Authors>
    <Description>Utilitaire professionnel de nettoyage des caches de shaders NVIDIA, Steam, CS2 et DirectX.</Description>
    <Copyright>Copyright © Syokos 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\app.ico" />
    <None Remove="Assets\steam.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\steam.png" />
    <None Include="Assets\icon.svg" />
    <None Include="Assets\steam-official.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="11.0.0" />
  </ItemGroup>

</Project>
